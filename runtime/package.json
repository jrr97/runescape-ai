{
  "name": "@runescape-ai/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "configure:local": "node scripts/configure-local.mjs",
    "gateway:start": "node gateway/scripts/start-gateway-session.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
