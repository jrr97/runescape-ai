{
  "schemaVersion": 1,
  "kind": "component",
  "id": "movement.go-to",
  "version": "1.0.0",
  "name": "Go to coordinate",
  "description": "Walk to a caller-supplied OSRS coordinate and return the reached position.",
  "tags": ["movement", "travel"],
  "inputs": {
    "coordinates": { "type": "coordinate", "description": "Destination world coordinate" },
    "tolerance": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2, "required": false }
  },
  "outputs": {
    "position": { "type": "coordinate" }
  },
  "entry": "observe",
  "nodes": {
    "observe": { "type": "action", "operation": "observe", "with": { "components": ["player"] } },
    "walk": {
      "type": "action",
      "operation": "walk",
      "with": {
        "x": "$inputs.coordinates.x",
        "y": "$inputs.coordinates.y",
        "plane": "$inputs.coordinates.plane",
        "tolerance": "$inputs.tolerance",
        "expectedRevision": "$nodes.observe.revision"
      },
      "retry": { "maxAttempts": 2, "backoffMs": 500 }
    },
    "done": { "type": "return", "with": { "position": "$nodes.walk.position" } }
  },
  "edges": [
    { "from": "observe", "to": "walk" },
    { "from": "walk", "to": "done" }
  ]
}

