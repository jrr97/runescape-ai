{
  "schemaVersion": 1,
  "kind": "component",
  "id": "movement.go-via",
  "version": "1.0.0",
  "name": "Go via waypoints",
  "description": "Walk a sequence of OSRS coordinates continuously, handing off to the next leg shortly before each intermediate waypoint.",
  "tags": ["movement", "travel"],
  "inputs": {
    "waypoints": {
      "type": "array",
      "description": "Ordered destination coordinates; intermediate legs use approach, the last uses tolerance"
    },
    "tolerance": { "type": "integer", "minimum": 0, "maximum": 10, "default": 2, "required": false },
    "approach": { "type": "integer", "minimum": 0, "maximum": 10, "default": 5, "required": false }
  },
  "outputs": {
    "position": { "type": "coordinate" }
  },
  "entry": "observe",
  "nodes": {
    "observe": { "type": "action", "operation": "observe", "with": { "components": ["player"] } },
    "walk": {
      "type": "action",
      "operation": "walk",
      "with": {
        "waypoints": "$inputs.waypoints",
        "tolerance": "$inputs.tolerance",
        "approach": "$inputs.approach",
        "expectedRevision": "$nodes.observe.revision"
      },
      "retry": { "maxAttempts": 2, "backoffMs": 500 }
    },
    "done": { "type": "return", "with": { "position": "$nodes.walk.position" } }
  },
  "edges": [
    { "from": "observe", "to": "walk" },
    { "from": "walk", "to": "done" }
  ]
}
